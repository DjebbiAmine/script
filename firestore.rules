rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for Call Center Administration elements
    match /associations/{id} {
      allow read, write: if true;
    }
    match /sequences/{id} {
      allow read, write: if true;
    }
    match /notes/{id} {
      allow read, write: if true;
    }
    match /consignes/{id} {
      allow read, write: if true;
    }
  }
}
